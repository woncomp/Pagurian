<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>false</EnableMsixTooling>
    <AppxGeneratePriEnabled>false</AppxGeneratePriEnabled>
    <Platforms>x64;ARM64</Platforms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Pagurian.Modules.Hello</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.UI.Reactor" Version="0.1.0-preview.12" />
    <ProjectReference Include="..\Pagurian.Sdk\Pagurian.Sdk.csproj" />
  </ItemGroup>

  <!-- Deploy the module dll next to the host exe's modules folder so the
       running app discovers it (see ModuleLoader). -->
  <Target Name="DeployToHostModules" AfterTargets="Build">
    <PropertyGroup>
      <HostModulesDir>$(MSBuildThisFileDirectory)..\Pagurian\bin\$(Platform)\$(Configuration)\$(TargetFramework)\modules\</HostModulesDir>
    </PropertyGroup>
    <MakeDir Directories="$(HostModulesDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(HostModulesDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
