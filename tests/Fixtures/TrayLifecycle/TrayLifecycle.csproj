<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>Pagurian</AssemblyName>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Platforms>x64</Platforms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.UI.Reactor" Version="0.1.0-preview.12" />
    <ProjectReference Include="../../../Pagurian.Sdk/Pagurian.Sdk.csproj" />
    <Compile Include="../../../Pagurian/ReactorDestroyedWindow.cs;../../../Pagurian/TrayWindowSession.cs;../../../Pagurian/TrayBackgroundSampler.cs;../../../Pagurian/TaskbarTrayLayout.cs;../../../Pagurian/TaskbarTrayPlacement.cs;../../../Pagurian/TaskbarTrayWindow.cs;../../../Pagurian/TaskbarInterop.cs;../../../Pagurian/TrayShells.cs;../../../Pagurian/ThemeService.cs" LinkBase="Host" />
    <Content Include="../../../Pagurian/Assets/Pagurian-256.ico" Link="Assets/Pagurian-256.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
