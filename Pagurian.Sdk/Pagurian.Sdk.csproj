<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="buildTransitive\Pagurian.Sdk.props" />

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <Version>$(PagurianSdkPackageVersion)</Version>
    <PackageId>Pagurian.Sdk</PackageId>
    <Authors>Pagurian Contributors</Authors>
    <Description>Contracts and UI integration surface for external Pagurian modules.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://gitea.mimimama.asia/woncomp/Pagurian</PackageProjectUrl>
    <RepositoryUrl>https://gitea.mimimama.asia/woncomp/Pagurian.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>false</EnableMsixTooling>
    <AppxGeneratePriEnabled>false</AppxGeneratePriEnabled>
    <!-- The host generates the only app PRI. SDK 10.0.302 otherwise advertises this disabled library's non-existent project PRI to it. -->
    <IncludeProjectPriFile>false</IncludeProjectPriFile>
    <Platforms>x64;ARM64</Platforms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Pagurian.Sdk</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.UI.Reactor" Version="$(PagurianReactorPackageVersion)" />
    <AssemblyMetadata Include="ReactorPackageVersion" Value="$(PagurianReactorPackageVersion)" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="buildTransitive\Pagurian.Sdk.props" Pack="true" PackagePath="buildTransitive\" />
  </ItemGroup>
</Project>
